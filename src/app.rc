#include <windows.h>

// 图标：6 档尺寸（16/32/48/64/128/256），和 Python 版同一份
1 ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SpaceSift"
            VALUE "FileDescription", "SpaceSift - Disk Space Analyzer and Cleaner"
            VALUE "ProductName", "SpaceSift"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "ProductVersion", "2.1.0.0"
            VALUE "OriginalFilename", "SpaceSift.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
